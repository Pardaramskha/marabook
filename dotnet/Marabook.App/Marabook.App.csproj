<Project Sdk="Microsoft.NET.Sdk">

  <!-- Marabook.App (portage Avalonia, P1) : l'application Avalonia 11 sur
       .NET 8, un seul code pour Windows, Linux et macOS. Interface 100 % en
       code (pas de XAML), comme l'app WPF qu'elle remplace. Elle compile le
       cœur (Marabook.Core) et n'en connaît que les contrats : IPlatform,
       IImageCodec, IFontEngine, Exchange.Rtf, Modules.CodeHost. -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Marabook</AssemblyName>
    <RootNamespace>Marabook.App</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationIcon>..\..\tools\app.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <InformationalVersion>1.1.0</InformationalVersion>
    <SatelliteResourceLanguages>fr</SatelliteResourceLanguages>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <!-- CS4014 : les boîtes de message lancées sans await (« feu et oublie »)
         sont voulues — l'appelant n'attend pas la fermeture. -->
    <NoWarn>CS0618;CS1591;CS4014</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Simple" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Marabook.Core\Marabook.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\..\tools\app.ico" Link="Assets\app.ico" />
  </ItemGroup>

  <!-- Les patch notes de chaque version (patchnotes/<VERSION>.md, le texte
       de Rémi) voyagent dans l'assembly : Aide › Nouveautés les relit hors
       ligne pour la version installée (07/10). CONVENTION.md n'en est pas. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\patchnotes\*.md" Exclude="..\..\patchnotes\CONVENTION.md" LogicalName="patchnotes/%(Filename)%(Extension)" />
    <!-- L'image de tête d'une version majeure (1/11, Rémi : patchnotes/marabook-1.1.0.jpg) : la fenêtre « Nouveautés » la montre hors ligne. -->
    <EmbeddedResource Include="..\..\patchnotes\*.jpg;..\..\patchnotes\*.png" LogicalName="patchnotes/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Les sons (1.1.0, 31/10, Rémi) : trois WAV PCM mono 44,1 kHz (succès,
       enregistrement, rapport d'erreur), convertis des .mp3 de Pixabay — joués
       sans décodage ni latence (Sounds.cs). -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\sounds\*.wav" LogicalName="sounds/%(Filename)%(Extension)" />
    <!-- Les images de tête des DLC (1/11, Rémi) : assets/dlc/<fichier>, montrées par la fenêtre d'un module. -->
    <EmbeddedResource Include="..\..\assets\dlc\*.jpg;..\..\assets\dlc\*.png" LogicalName="dlc/%(Filename)%(Extension)" />
    <!-- Le dictionnaire d'orthographe à côté de la DLL (1/11) : SpellChecker le
         cherche dans <exe>/dict ; publish.ps1 le copie dans l'archive, mais la
         sonde de l'intégration continue tourne sur bin/ — sans cette copie,
         l'orthographe y était muette (0 relevé). -->
    <None Include="..\..\dict\*" Link="dict\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
